# Agente de Opportuni con cobro x402 (testnet), para correr detrás de Caddy en el
# servidor. Contexto: la raíz del repo.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY vendor ./vendor
RUN npm ci
COPY . .
RUN npx next build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production PORT=3000
COPY --from=build /app ./
RUN npm prune --omit=dev && addgroup -S app && adduser -S app -G app
USER app
EXPOSE 3000
CMD ["npx", "next", "start", "-p", "3000"]
