# =============================================================================
# Opportuni — variables de entorno (guía)
# Copia este archivo a `.env.local` y llena los valores. NO subas `.env.local`.
# Las que empiezan con NEXT_PUBLIC_ se exponen al navegador (no pongas secretos).
# =============================================================================

# ---- Servicios de pago ----
# Los pagos on-chain (wallet Accesly) se retiraron. Las tarjetas de "Review de
# CV" y "Asesoría 1:1" del home están desactivadas hasta definir otro medio de
# cobro; /cv y /cv/asesoria siguen cobrando por transferencia (CLABE en el
# código de esas páginas) y no necesitan variables aquí.

# ---- Post-pago ----
# Google Calendar de citas (versión embebible con ?gv=true).
NEXT_PUBLIC_CALENDLY_URL=https://calendar.google.com/calendar/appointments/schedules/XXXX?gv=true

# ---- Dashboard admin (/admin) ----
# DESACTIVADO. El acceso se autenticaba con la wallet Accesly del usuario
# (NEXT_PUBLIC_ADMIN_WALLETS); al retirar esa infra no quedó gate, así que
# /admin muestra un aviso y /api/admin/* responde 503. Para reactivarlo hay que
# implementar antes un mecanismo de acceso nuevo y poner ADMIN_API_ENABLED en
# app/lib/submissions.ts en true.
# (Opcional) Google Calendar/agenda para embeber en "Reuniones".
NEXT_PUBLIC_ADMIN_CALENDAR_URL=

# ---- Supabase (tracking de vacantes: clicks + postulantes) ----
# Proyecto y anon key (la anon key es pública por diseño; RLS protege los datos).
# Si se dejan vacíos, el código usa el proyecto por default del repo.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# ---- Vercel Blob (almacenamiento de CVs) ----
# SECRETO — no lo expongas. Obténlo en Vercel → Storage → tu Blob store.
# Sin él, la subida cae a ./uploads local (solo dev).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx
# Informativos (opcionales; solo si activas webhooks de Blob):
BLOB_STORE_ID=store_xxxxxxxxxxxx
BLOB_WEBHOOK_PUBLIC_KEY=

# ---- Agente con cobro por uso (x402) ----
# /api/agente cobra cada consulta en USDC sobre Stellar desde una wallet Accesly.
# Sin X402_PAY_TO o X402_FACILITATOR_URL la ruta responde 503.
X402_NETWORK=stellar:testnet
X402_PRICE=$0.01
X402_PAY_TO=G...
X402_FACILITATOR_URL=https://x402-testnet.accesly.xyz/facilitator
# Opcional: con key, el agente responde con Claude; sin key, por búsqueda.
ANTHROPIC_API_KEY=
# De dónde lee las vacantes el agente (API pública de Opportuni).
OPPORTUNI_VACANTES_URL=https://opportuni.xyz/api/vacantes
